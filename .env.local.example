# Khoj config — one file for both local paths:
#   * Full stack with only Docker:  cp .env.local.example .env  (compose reads .env)
#   * No-Docker path: scripts/start-local.sh writes .env.local for you after prompting.
WEB_PORT=8080
AGENT_PORT=8090

# Data: SQLite db + (local backend) originals live under here.
KHOJ_DATA_DIR=./data
# Originals storage: local = disk, gcs = Google bucket (KHOJ_BUCKET).
KHOJ_STORAGE=local
KHOJ_BUCKET=

# Built-in auth: shared signing secret (web + agent MUST match) and the
# email that becomes platform super admin at sign-in.
KHOJ_AUTH_SECRET=change-me-to-a-long-random-string
KHOJ_SUPER_ADMIN_EMAIL=you@example.com

# --- OpenRAG -------------------------------------------------------------
# Full-stack compose: leave OPENRAG_URL unset — compose wires Khoj to the
# bundled backend (http://openrag-backend:8000) automatically.
# External OpenRAG (e.g. the GKE stack): set its URL here instead.
#OPENRAG_URL=http://34.102.202.103/api

# Providers + models for OpenRAG onboarding and the Khoj chat agent.
# OpenAI is the default below; for fully local models set the providers
# to ollama (and OLLAMA_ENDPOINT to your host Ollama).
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OPENAI_MODEL=gpt-4o-mini
# Gemini recipe (the GKE configuration): put the Google AI Studio key in
# OPENAI_API_KEY, then set
#   LLM_PROVIDER=gemini        LLM_MODEL=gemini-3.5-flash
#   EMBEDDING_PROVIDER=gemini  EMBEDDING_MODEL=gemini-embedding-001
#   OPENAI_MODEL=gemini-3.5-flash
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRAG uses LiteLLM's native gemini provider (key only, no Vertex);
# the Khoj agent talks to Gemini's OpenAI-compatible endpoint directly.
# Optional custom OpenAI-compatible endpoint for the agent and for
# OpenRAG (passed to its OpenAI provider as api_base). Blank = default.
OPENAI_BASE_URL=

# Local-stack service passwords (compose-only defaults exist; set your
# own here). OpenSearch admin is used by Dashboards at :5601, Langflow's
# superuser signs in at :7860.
OPENSEARCH_PASSWORD=KhojLocal!234
LANGFLOW_SUPERUSER=langflow
LANGFLOW_SUPERUSER_PASSWORD=KhojLangflow!234
# Hostnames Langflow may call even when they resolve to private IPs
# (SSRF guard) — needed for internal model endpoints. Comma-separated.
LANGFLOW_SSRF_ALLOWED_HOSTS=

# Jira ticket button (blank token = feature off).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
JIRA_API_TOKEN=
